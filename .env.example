# Redis local (servicio del docker-compose.yml)
REDIS_URL=redis://127.0.0.1:6379

# Clave para firmar sesiones. Generar localmente con:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# Solo se usan al ejecutar `npm run seed` (primer administrador local)
ADMIN_USER=admin
ADMIN_PASSWORD=
ADMIN_NAME=Administrador
