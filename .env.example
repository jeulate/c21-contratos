# Redis local (servicio del docker-compose.yml)
REDIS_URL=redis://127.0.0.1:6379

# En local usa el disco del proyecto; en Vercel configura bunny y sus credenciales.
# CONTRACT_EVIDENCE_STORAGE=local
# CONTRACT_EVIDENCE_DIR=
# Bunny Storage: crea una Storage Zone privada y copia su contraseña desde Access.
# Regiones admitidas: de, uk, ny, la, sg, se, br, jh, syd.
# En Vercel añade estos valores como variables de entorno, nunca los subas a Git.
# CONTRACT_EVIDENCE_STORAGE=bunny
# BUNNY_STORAGE_ZONE=
# BUNNY_STORAGE_PASSWORD=
# BUNNY_STORAGE_REGION=br

# Clave para firmar sesiones. Generar localmente con:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# Solo se usan al ejecutar `npm run seed` (primer administrador local)
ADMIN_USER=admin
ADMIN_PASSWORD=
ADMIN_NAME=Administrador
